proc mixed data = minsdlsenvt;
	class block dorm year;
	model lminsdls = dorm year dorm*year;
	random block;
	lsmeans dorm dorm*year / cl adjust=tukey;
 
/*envtal effects within dorm treatments*/
proc mixed data = minsdlsenvt;
	class block envt year;
	model lminsdls = envt year envt*year;
	random block;
	lsmeans envt / cl adjust=tukey;
	
