proc univariate plot normal;
	var dailyavg dailymax dailymin;
proc univariate plot normal;
	var savg smax smin;
proc univariate plot normal;
	var lavg lmax lmin;
proc univariate plot normal;
	var llavg llmax llmin;
	/*the distribution from the square root transformed data looks the best, but not perfect*
proc sort;
	by trt;
proc means n mean stderr var;
	var dailyavg dailymax dailymin;
	by trt;
proc sort;
	by year;
proc means n mean stderr var;
	var dailyavg dailymax dailymin;
	by year;
proc sort;
	by monyear;
proc means n mean stderr var;
	var dailyavg dailymax dailymin;
	by monyear;
	*/
proc sort;
	by trt monyear;
ods excel file = "Z:\Chapter 3_DND\SWCResults_Avg.xlsx" style = meadow;
proc mixed;
	class block monyear trt;
	model dailyavg = trt monyear trt*monyear;
	random block;
	lsmeans trt trt*monyear / cl adjust=tukey;
	run;
	ods excel close;

ods excel file = "Z:\Chapter 3_DND\SWCResults_Max.xlsx" style = meadow;
proc mixed;
	class block monyear trt;
	model dailymax = trt monyear trt*monyear;
	random block;
	lsmeans trt trt*monyear / cl adjust=tukey;
	run;
	ods excel close;

ods excel file = "Z:\Chapter 3_DND\SWCResults_Min.xlsx" style = meadow;
proc mixed;
	class block monyear trt;
	model dailymin = trt monyear trt*monyear;
	random block;
	lsmeans trt trt*monyear / cl adjust=tukey; 
	run;
	ods excel close;
run;
quit;
